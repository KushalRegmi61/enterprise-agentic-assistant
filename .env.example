# --- Agentic-assistant (required to boot the agent) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Legacy fallback; prefer the two route vars below.
OPENAI_CHAT_MODEL=gpt-4o-mini
AGENTIC_ASSISTANT_FAST_MODEL=gpt-4o-mini
AGENTIC_ASSISTANT_REASONING_MODEL=gpt-5-nano
AGENTIC_ASSISTANT_LLM_TIMEOUT_SECONDS=120

# Corpus tenant stamped on this host's indexed data.
AGENTIC_ASSISTANT_TENANT=agentic-assistant

# Service-to-service token for POST /ingest + DELETE /sources. Empty = 503 fail-closed.
AGENTIC_ASSISTANT_SERVICE_TOKEN=
AGENTIC_ASSISTANT_SERVICE_URL=http://localhost:8001
# Neon Postgres for assistant users, conversations, RAG registry + cache.
AGENTIC_ASSISTANT_DATABASE_URL=
# First admin bootstrap. Leave both empty only when an admin already exists.
AGENTIC_ASSISTANT_ADMIN_EMAIL=
AGENTIC_ASSISTANT_ADMIN_PASSWORD=
# Assistant login JWT.
AGENTIC_ASSISTANT_JWT_SECRET=
AGENTIC_ASSISTANT_JWT_TTL_SECONDS=43200

# Memory + WebSocket chat.
AGENTIC_ASSISTANT_MAX_HISTORY_TURNS=6
AGENTIC_ASSISTANT_MEMORY_MAX_TOKENS=2048
AGENTIC_ASSISTANT_MEMORY_SUMMARY_MAX_TOKENS=768
AGENTIC_ASSISTANT_WS_TICKET_TTL_SECONDS=60
AGENTIC_ASSISTANT_CORS_ORIGINS='["http://localhost:3000", "http://localhost:3001"]'

# --- Langfuse tracing (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# --- Ports / frontend wiring ---
AGENT_PORT=8001
NEXT_PUBLIC_AGENT_URL=http://localhost:8001
